{
  "name": "Quest 02: AI Video Topic Collector",
  "nodes": [
    {
      "parameters": {
        "feedUrl": "https://techcrunch.com/feed/",
        "pollTimes": {
          "item": [{"mode": "everyX", "value": 30, "unit": "minutes"}]
        }
      },
      "id": "rss-002",
      "name": "Quest 1: RSS接続",
      "type": "n8n-nodes-base.rssFeedReadTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "f1", "name": "article_title",   "value": "={{ $json.title }}",          "type": "string"},
            {"id": "f2", "name": "article_url",     "value": "={{ $json.link }}",           "type": "string"},
            {"id": "f3", "name": "article_desc",    "value": "={{ $json.contentSnippet }}", "type": "string"},
            {"id": "f4", "name": "source_type",     "value": "rss",                         "type": "string"}
          ]
        }
      },
      "id": "set-article",
      "name": "記事データ抽出",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [400, 180]
    },
    {
      "parameters": {
        "url": "https://www.reddit.com/r/technology/hot.json?limit=5",
        "options": {
          "headers": {
            "parameters": [
              {"name": "User-Agent", "value": "n8n-automation-quest-bot/1.0"}
            ]
          }
        }
      },
      "id": "http-reddit",
      "name": "Quest 1: Reddit取得",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 420]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "merge-001",
      "name": "Quest 2: データ統合",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [620, 300]
    },
    {
      "parameters": {
        "jsCode": "const all = $input.all();\nconst rss = all.find(i => i.json.source_type === 'rss');\nconst reddit = all.find(i => i.json.data && i.json.data.children);\n\nconst trends = reddit?.json.data?.children\n  ?.slice(0, 3)\n  .map((c, i) => `${i + 1}. ${c.data.title}`)\n  .join('\\n') || 'Redditトレンド取得できず';\n\nreturn [{\n  json: {\n    article_title: rss?.json.article_title || '(タイトルなし)',\n    article_url:   rss?.json.article_url   || '',\n    article_desc:  rss?.json.article_desc  || '',\n    reddit_trends: trends\n  }\n}];"
      },
      "id": "code-ctx",
      "name": "コンテキスト構築",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=あなたはYouTube Shorts/TikTok専門のコンテンツストラテジストです。\n\n以下のニュース記事とRedditのトレンドから、バズる動画ネタを生成してください。\n\n【記事タイトル】\n{{ $json.article_title }}\n\n【記事概要】\n{{ $json.article_desc }}\n\n【Redditのトレンド話題】\n{{ $json.reddit_trends }}\n\n条件:\n- 3秒フック付き（視聴者が続きを見たくなる一言）\n- 感情を動かす内容\n- 100点満点でバズ可能性を評価\n\n出力形式（必ずこの形式で）:\nタイトル: [動画タイトル]\nフック: [3秒フック]\n概要: [30秒で説明できる動画内容]\nスコア: [数字のみ]"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "openai-002",
      "name": "Quest 3: AI動画ネタ化",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [1060, 300],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const output = $input.item.json.output?.[0]?.content?.[0]?.text || '';\nconst ctx    = $('コンテキスト構築').item.json;\n\nconst get = (label) => {\n  const m = output.match(new RegExp(label + '[:：]\\\\s*([\\\\s\\\\S]+?)(?=\\\\n[^\\\\n]+[:：]|$)'));\n  return m ? m[1].trim() : '';\n};\n\nreturn [{\n  json: {\n    date:        new Date().toISOString(),\n    video_title: get('タイトル') || '(取得失敗)',\n    hook:        get('フック')   || '(取得失敗)',\n    summary:     get('概要')     || '(取得失敗)',\n    score:       parseInt((output.match(/スコア[:：]\\s*(\\d+)/) || [])[1] || '0', 10),\n    source_url:  ctx.article_url\n  }\n}];"
      },
      "id": "code-parse-02",
      "name": "AI出力パース",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {"__rl": true, "value": "REPLACE_WITH_YOUR_SPREADSHEET_ID", "mode": "id"},
        "sheetName":  {"__rl": true, "value": "動画ネタ帳", "mode": "name"},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date":        "={{ $json.date }}",
            "VideoTitle":  "={{ $json.video_title }}",
            "Hook":        "={{ $json.hook }}",
            "Summary":     "={{ $json.summary }}",
            "Score":       "={{ $json.score }}",
            "SourceURL":   "={{ $json.source_url }}"
          }
        }
      },
      "id": "sheets-002",
      "name": "Quest 5: ネタ帳保存",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [1500, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets OAuth"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "cond-score",
              "leftValue":  "={{ $json.score }}",
              "rightValue": 70,
              "operator": {"type": "number", "operation": "gte"}
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-002",
      "name": "Quest 4: スコア判定 (>=70)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1720, 300]
    },
    {
      "parameters": {
        "webhookUri": "REPLACE_WITH_YOUR_DISCORD_WEBHOOK_URL",
        "content": "=**【動画ネタ発見】** バズスコア: {{ $json.score }}/100\n\n**{{ $json.video_title }}**\n\n**フック:** {{ $json.hook }}\n\n{{ $json.summary }}\n\n元記事: {{ $json.source_url }}",
        "options": {"username": "動画ネタBotGuild"}
      },
      "id": "discord-002",
      "name": "Quest 5: Discord報告",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [1940, 180]
    }
  ],
  "connections": {
    "Quest 1: RSS接続": {
      "main": [[
        {"node": "記事データ抽出",    "type": "main", "index": 0},
        {"node": "Quest 1: Reddit取得", "type": "main", "index": 0}
      ]]
    },
    "記事データ抽出": {
      "main": [[{"node": "Quest 2: データ統合", "type": "main", "index": 0}]]
    },
    "Quest 1: Reddit取得": {
      "main": [[{"node": "Quest 2: データ統合", "type": "main", "index": 1}]]
    },
    "Quest 2: データ統合": {
      "main": [[{"node": "コンテキスト構築", "type": "main", "index": 0}]]
    },
    "コンテキスト構築": {
      "main": [[{"node": "Quest 3: AI動画ネタ化", "type": "main", "index": 0}]]
    },
    "Quest 3: AI動画ネタ化": {
      "main": [[{"node": "AI出力パース", "type": "main", "index": 0}]]
    },
    "AI出力パース": {
      "main": [[{"node": "Quest 5: ネタ帳保存", "type": "main", "index": 0}]]
    },
    "Quest 5: ネタ帳保存": {
      "main": [[{"node": "Quest 4: スコア判定 (>=70)", "type": "main", "index": 0}]]
    },
    "Quest 4: スコア判定 (>=70)": {
      "main": [
        [{"node": "Quest 5: Discord報告", "type": "main", "index": 0}],
        []
      ]
    }
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "meta": {
    "templateId": "automation-quest-02-video-topic-collector",
    "instanceId": "template-lab-sample"
  }
}
