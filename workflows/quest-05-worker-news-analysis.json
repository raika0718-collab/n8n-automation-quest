{
  "name": "Quest 05 Worker: News Analysis",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {"name": "mission"},
            {"name": "date"},
            {"name": "mode"}
          ]
        }
      },
      "id": "trigger-news-worker",
      "name": "司令部から起動",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://techcrunch.com/feed/",
        "options": {}
      },
      "id": "rss-news-worker",
      "name": "ニュースRSS取得",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=あなたは情報収集AIアシスタントです。ニュース記事を分析して要約と重要度評価を行います。\n\n以下の記事を3行で要約してください。\nさらに、AI・自動化・テック分野の重要度を100点満点で評価してください。\n\nタイトル: {{ $json.title }}\n内容: {{ $json.contentSnippet }}\n\n出力形式（必ずこの形式で）:\n要約: [3行の要約]\n重要度: [数字のみ]"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "openai-news-worker",
      "name": "ニュースAI解析",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [640, 300],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiOutput = $input.item.json.output?.[0]?.content?.[0]?.text || '';\nconst rssData = $('ニュースRSS取得').item.json;\n\nconst summaryMatch = aiOutput.match(/要約[:：]\\s*([\\s\\S]+?)(?=\\n重要度|$)/);\nconst scoreMatch = aiOutput.match(/重要度[:：]\\s*(\\d+)/);\n\nreturn [{\n  json: {\n    date: new Date().toISOString(),\n    title: rssData.title || '(タイトルなし)',\n    summary: summaryMatch ? summaryMatch[1].trim() : 'AIが要約を生成できませんでした',\n    score: scoreMatch ? parseInt(scoreMatch[1], 10) : 0,\n    url: rssData.link || rssData.url || '(URLなし)'\n  }\n}];"
      },
      "id": "parse-news-worker",
      "name": "ニュース結果返却",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 300]
    }
  ],
  "connections": {
    "司令部から起動": {
      "main": [[{"node": "ニュースRSS取得", "type": "main", "index": 0}]]
    },
    "ニュースRSS取得": {
      "main": [[{"node": "ニュースAI解析", "type": "main", "index": 0}]]
    },
    "ニュースAI解析": {
      "main": [[{"node": "ニュース結果返却", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateId": "automation-quest-05-worker-news-analysis",
    "instanceId": "template-lab-sample"
  }
}
